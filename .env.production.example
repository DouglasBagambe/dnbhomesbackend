NODE_ENV=production
PORT=3000
# Isolated production DB URI with verified TLS. Never use the demo database.
MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Exact public HTTPS origins, comma separated. No paths/wildcards.
CORS_ORIGINS=
# Verified ingress proxy hops, required explicitly; 0 means direct access.
TRUST_PROXY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
MEDIA_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
LOG_LEVEL=info
# One-time admin bootstrap credentials are supplied separately, then removed.
