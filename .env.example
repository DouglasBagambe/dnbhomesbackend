NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/homes_development
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Direct local server. In production set the VERIFIED proxy-hop count explicitly.
TRUST_PROXY=0
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
MEDIA_DRIVER=local
MEDIA_PUBLIC_URL=http://localhost:3000/media
MEDIA_LOCAL_PATH=uploads
# Production S3/R2 adapter: all fields are mandatory at startup in production.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
LOG_LEVEL=info
# Used only by npm run seed:admin
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Consumer accounts are optional until authenticated email delivery is configured.
CONSUMER_ACCOUNTS_ENABLED=false
CONSUMER_AUTH_URL=
CONSUMER_AUTH_SECRET=
# Independent server-only secret shared with the Website BFF; never NEXT_PUBLIC.
CONSUMER_WEB_PROXY_SECRET=
CONSUMER_MAIL_DRIVER=smtp
CONSUMER_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Development/test only: CONSUMER_MAIL_DRIVER=local and an absolute private folder.
# CONSUMER_MAIL_LOCAL_PATH=/tmp/homes-private-local-mail
