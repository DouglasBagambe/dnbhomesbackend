NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/homes_development
CORS_ORIGINS=http://localhost:3001
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
MEDIA_DRIVER=local
MEDIA_PUBLIC_URL=http://localhost:3000/media
MEDIA_LOCAL_PATH=uploads
# Production S3/R2 adapter
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
LOG_LEVEL=info
# Used only by npm run seed:admin
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
