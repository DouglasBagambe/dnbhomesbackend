{
  "name": "homes-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production API for the dnb Homes platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "test": "MONGOMS_DISTRO=ubuntu-22.04 node --test --test-concurrency=1 test/*.test.js",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:demo": "node scripts/seed-demo-properties.js",
    "seed:demo:remove": "node scripts/remove-demo-properties.js",
    "migrate:v1": "node scripts/migrate-v1.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "multer": "^2.0.2",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1"
  }
}
